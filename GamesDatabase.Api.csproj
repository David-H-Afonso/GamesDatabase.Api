<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>3.5.1</Version>
        <AssemblyVersion>3.5.1.0</AssemblyVersion>
        <FileVersion>3.5.1.0</FileVersion>
        <Authors>David H. Afonso</Authors>
        <Product>Games Database API</Product>
        <Description>Owned game libraries, playthroughs, Steam integrations and safe data workflows with ASP.NET Core</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next"
                          Version="4.0.3" />
        <PackageReference Include="SkiaSharp"
                          Version="4.157.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies"
                          Version="4.157.0" />
        <PackageReference Include="CsvHelper"
                          Version="33.1.0" />
        <PackageReference Include="HtmlAgilityPack"
                          Version="1.12.2" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"
                          Version="10.0.15" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"
                          Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"
                          Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design"
                          Version="10.0.15" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools"
                          Version="10.0.15" />
        <PackageReference Include="Swashbuckle.AspNetCore"
                          Version="10.3.1" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="tests\**\*.cs" />
        <Content Remove="tests\**\*" />
        <None Remove="tests\**\*" />
        <EmbeddedResource Remove="tests\**\*" />
    </ItemGroup>
</Project>
